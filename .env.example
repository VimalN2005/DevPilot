# DevPilot Environment Configuration

# Server
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development
CORS_ORIGINS=["*"]

# Security & JWT
JWT_SECRET=supersecret_devpilot_jwt_signing_key_32_bytes_long!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (Leave blank or sqlite for standalone zero-dependency mode)
# In production: postgresql+asyncpg://postgres:postgres@localhost:5432/devpilot
DATABASE_URL=sqlite+aiosqlite:///./devpilot.db

# Redis & Celery (Falls back to in-memory queue if Redis is not running)
# In production: redis://localhost:6379/0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# LLM Providers (Configure at least one or leave blank for offline simulation)
GEMINI_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_MODEL=gemini-2.5-flash

# GitHub Integration
GITHUB_TOKEN=
